{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrameNapper",
  "mainBinaryName": "framenapper",
  "version": "0.7.0",
  "identifier": "dev.framenapper.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FrameNapper",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost framenapper: http://framenapper.localhost; img-src 'self' asset: http://asset.localhost data: blob: framenapper: http://framenapper.localhost; style-src 'self' 'unsafe-inline'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Daniel Trillo",
    "copyright": "© 2026 Daniel Trillo",
    "homepage": "https://github.com/Hayababuza/FrameNapper",
    "category": "Utility",
    "shortDescription": "Screenshots and GIF recordings with annotations",
    "longDescription": "FrameNapper combines a screenshot tool with annotations (arrows, text, blur, numbered markers, pins) and a screen recorder with a frame editor that saves GIF, APNG, WebP, MP4 and WebM. Works on Windows, macOS and Linux (X11 and Wayland).",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libpipewire-0.3-0"],
        "section": "graphics",
        "conflicts": ["frame-nab"],
        "replaces": ["frame-nab"]
      },
      "rpm": {
        "depends": ["pipewire-libs"],
        "conflicts": ["FrameNab"],
        "obsoletes": ["FrameNab"]
      }
    },
    "windows": {
      "wix": {
        "upgradeCode": "a341bb9e-8a2e-517a-acda-f333f3ddea93"
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "currentUser",
        "languages": ["English", "German"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3MkEwQ0ZBMTIzMkI1MEEKUldRS3RUSVMrZ3dxWnoveWpzZDVJVk1kL2RBUnJpclViRW8zR3BhbDlKOU5QZTBDSkU2L2ZMTkYK",
      "endpoints": ["https://github.com/Hayababuza/FrameNapper/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
