{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrameNab",
  "mainBinaryName": "framenab",
  "version": "0.3.0",
  "identifier": "dev.framenab.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FrameNab",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost framenab: http://framenab.localhost; img-src 'self' asset: http://asset.localhost data: blob: framenab: http://framenab.localhost; style-src 'self' 'unsafe-inline'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Daniel Trillo",
    "copyright": "© 2026 Daniel Trillo",
    "homepage": "https://github.com/Hayababuza/FrameNab",
    "category": "Utility",
    "shortDescription": "Screenshots and GIF recordings with annotations",
    "longDescription": "FrameNab combines a screenshot tool with annotations (arrows, text, blur, numbered markers, pins) and a screen recorder with a frame editor that saves GIF, APNG, WebP, MP4 and WebM. Works on Windows, macOS and Linux (X11 and Wayland).",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libpipewire-0.3-0"],
        "section": "graphics"
      },
      "rpm": {
        "depends": ["pipewire-libs"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "German"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
