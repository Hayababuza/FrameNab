{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Berechtigungen für alle FrameNab-Fenster",
  "windows": ["main", "overlay", "recorder", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
